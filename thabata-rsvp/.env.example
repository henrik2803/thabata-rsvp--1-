# Copie para .env e preencha localmente; nunca envie os valores ao Git ou ao chat.
ADMIN_PASSWORD=
PORT=3000
NODE_ENV=development
# Vazio: SQLite local. Em produção é obrigatório PostgreSQL (Neon).
DATABASE_URL=
# Apenas para SQLite local. Padrão: data/ dentro do aplicativo.
# DATA_DIR=
# Opcional localmente. No Render usa RENDER_EXTERNAL_URL automaticamente.
# Para domínio próprio, configure a origem HTTPS pública, sem caminho.
# APP_ORIGIN=https://seu-dominio.example
# Local direto: 0. Render: 1. Não habilite atrás de proxies desconhecidos.
TRUST_PROXY_HOPS=0
# Migração manual: caminho absoluto do SQLite revisado; não é usado pelo servidor.
# MIGRATION_SQLITE_PATH=
